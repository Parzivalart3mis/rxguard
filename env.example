# RxGuard Environment Variables
#
# Copy this file to .env and fill in your values.
#
# IMPORTANT: VITE_GROQ_API_KEY has been removed. The Groq API key is now
# handled server-side only (GROQ_API_KEY below), so it is never exposed
# in the browser bundle.  Rotate any key that was previously committed here.
#
# Get a free Groq API key from: https://console.groq.com/keys

# Server-side Groq key (used by server/routes/ai.js — never sent to browser)
GROQ_API_KEY=your_groq_api_key_here

# Set to true to have the React app call the Express backend instead of
# falling back to the static data files (default for local dev).
VITE_USE_BACKEND=true

# ── FHIR R4 Integration ────────────────────────────────────────────────────────
# Base URL of the FHIR R4 server.
# Defaults to the public HAPI FHIR server (Synthea data, unauthenticated).
# Replace with your EHR sandbox URL for Epic/Cerner/etc.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Bearer token for authenticated FHIR servers (EHR sandboxes, SMART on FHIR).
# Leave blank for unauthenticated public servers.
FHIR_AUTH_TOKEN=

# Number of patients to fetch from FHIR (default: 20).
FHIR_PATIENT_COUNT=20

# Show a "Live FHIR" / "Synthetic data" badge in the patient selector.
# Set to true during development to verify which data source is active.
VITE_FHIR_SHOW_SOURCE=false
